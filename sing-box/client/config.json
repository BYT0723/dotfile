{
  "log": {
    "level": "error"
  },
  "dns": {
    "servers": [
      { "tag": "ali", "type": "udp", "server": "223.5.5.5" },
      { "tag": "cloudflare-tls", "type": "tls", "server": "1.1.1.1" },
      {
        "tag": "google-tls",
        "type": "tls",
        "server": "8.8.8.8",
        "detour": "trojan-out"
      },
      {
        "tag": "google",
        "type": "udp",
        "server": "8.8.8.8",
        "detour": "trojan-out"
      },
      { "tag": "local", "type": "local" }
    ],
    "rules": [
      {
        "rule_set": [
          "geosite-proxy-custom",
          "geosite-gfw",
          "geosite-youtube",
          "geosite-tiktok"
        ],
        "server": "google"
      }
    ],
    "final": "local",
    "strategy": "prefer_ipv4",
    "cache_capacity": 4096
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"],
      "route_address": ["0.0.0.0/1", "128.0.0.0/1", "::/1", "8000::/1"],
      "auto_route": true,
      "auto_redirect": true
    },
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 1080,
      "users": []
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-out"
    },
    {
      "type": "hysteria2",
      "tag": "hy2-out",
      "server": "x.byt0723.xyz",
      "server_port": 21212,
      "up_mbps": 100,
      "down_mbps": 100,
      "obfs": {
        "type": "salamander",
        "password": "tylersobfs"
      },
      "password": "tylersproxy",
      "tls": {
        "enabled": true,
        "server_name": "blog.byt0723.xyz"
      }
    },
    {
      "type": "trojan",
      "tag": "trojan-out",
      "server": "x.byt0723.xyz",
      "server_port": 9723,
      "password": "tylersproxy",
      "tls": {
        "enabled": true,
        "server_name": "blog.byt0723.xyz",
        "utls": { "enabled": true, "fingerprint": "firefox" }
      },
      "multiplex": {
        "enabled": true
      }
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "rules": [
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "ip_is_private": true, "outbound": "direct-out" },
      { "process_name": ["trojan-go"], "outbound": "direct-out" },
      { "inbound": ["socks-in"], "outbound": "trojan-out" },
      {
        "rule_set": ["geosite-youtube"],
        "outbound": "hy2-out"
      },
      {
        "rule_set": [
          "geosite-tiktok",
          "geoip-telegram",
          "geosite-gfw",
          "geosite-proxy-custom"
        ],
        "outbound": "trojan-out"
      },
      { "outbound": "direct-out" }
    ],
    "rule_set": [
      {
        "tag": "geosite-proxy-custom",
        "type": "local",
        "format": "source",
        "path": "/etc/sing-box/rules/geosite-proxy.json"
      },
      {
        "tag": "geosite-gfw",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/gfw.srs",
        "download_detour": "trojan-out"
      },
      {
        "tag": "geosite-ai",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/ai.srs",
        "download_detour": "trojan-out"
      },
      {
        "tag": "geoip-telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/telegramip.srs",
        "download_detour": "trojan-out"
      },
      {
        "tag": "geosite-youtube",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/youtube.srs",
        "download_detour": "trojan-out"
      },
      {
        "tag": "geosite-tiktok",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/tiktok.srs",
        "download_detour": "trojan-out"
      }
    ]
  }
}
